[
  {
    "name": "mrg_sc",
    "description": "original MRG-SC baseline",
    "engine": "mrg_sc",
    "infer": {}
  },
  {
    "name": "full_model",
    "description": "MRG-Tree full model",
    "engine": "mrg_tree",
    "infer": {}
  },
  {
    "name": "w_o_mrg_prior",
    "description": "remove MRG prior from tree scoring",
    "engine": "mrg_tree",
    "infer": {
      "TREE_BETA_MRG": 0.0
    }
  },
  {
    "name": "w_o_history_prior",
    "description": "remove history prior",
    "engine": "mrg_tree",
    "infer": {
      "HISTORY_BONUS_STEP1": 0.0,
      "HISTORY_BONUS_LATER": 0.0,
      "TREE_ETA_HISTORY": 0.0
    }
  },
  {
    "name": "w_o_state_dominance",
    "description": "remove state dominance pruning",
    "engine": "mrg_tree",
    "infer": {
      "TREE_ENABLE_STATE_DOMINANCE": false
    }
  },
  {
    "name": "w_o_dag_order",
    "description": "ignore DAG edge order and only keep requirement nodes",
    "engine": "mrg_tree",
    "infer": {
      "IGNORE_DAG_ORDER": true
    }
  },
  {
    "name": "w_o_depends_on",
    "description": "remove DEPENDS_ON admission constraint",
    "engine": "mrg_tree",
    "infer": {
      "DISABLE_DEPENDS_ON": true,
      "TREE_GAMMA_DEP": 0.0
    }
  }
]
